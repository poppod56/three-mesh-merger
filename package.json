{
  "name": "@poppod/three-mesh-merger-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for three-mesh-merger library and examples",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter example-vite dev",
    "build:core": "pnpm --filter @poppod/three-mesh-merger build",
    "build:example": "pnpm --filter example-vite build"
  },
  "keywords": [
    "three.js",
    "3d",
    "mesh",
    "merge",
    "glb",
    "texture-atlas"
  ],
  "author": "poppod",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "lodash": ">=4.18.0",
      "minimatch@<3.1.2": "^3.1.2",
      "fast-uri": ">=3.1.6 <4.0.0",
      "brace-expansion": ">=2.1.4 <3.0.0",
      "nanoid": ">=3.3.18 <4.0.0",
      "postcss": ">=8.5.18 <9.0.0",
      "vite": ">=6.4.3 <7.0.0",
      "@babel/core": ">=7.29.6 <8.0.0",
      "browserslist": ">=4.28.7 <5.0.0"
    }
  }
}
